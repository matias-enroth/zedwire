370 PRINT "BAD ";PEEK 16522+256*PEEK 16523
380 PRINT "UNDERRUNS ";PEEK 16524+256*PEEK 16525
390 PRINT "LATE ";PEEK 16526+256*PEEK 16527
400 IF B=0 THEN STOP
410 PRINT
420 PRINT "ANY KEY: BACK TO THE LIST"
