10 @MC
20 GOTO 100
30 SAVE "SERVICE"
40 GOTO 100
100 SLOW
110 ZXPAND "GET PARM"
120 LET L=PEEK 16446
130 LET K$=""
140 IF L=0 OR L>30 THEN GOTO 210
150 FOR I=0 TO L-1
160 LET C=PEEK (16449+I)
170 IF C>127 THEN LET C=C-128
190 LET K$=K$+CHR$ C
200 NEXT I
210 IF K$="" THEN PRINT "NO PARM (LEN ";L;"). SERVICE?"
220 IF K$="" THEN INPUT K$
230 CLS
240 PRINT "> ";K$
250 ZXPAND "OPE SER 38400"
260 ZXPAND "PUT SER "+K$
270 LET N=USR 16514
280 ZXPAND "CLO SER"
290 IF N=0 THEN PRINT "(NO REPLY - IS ZXSERVICE UP?)"
300 IF N>0 THEN RAND USR 16517
310 LET R=PEEK 16520+256*PEEK 16521
320 IF N<R THEN PRINT
330 IF N<R THEN PRINT "(SHORT ";N;"/";R;")"
