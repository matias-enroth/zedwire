10 @MC
20 PRINT "ZXPAND+ PING/PONG"
30 ZXPAND "OPE SER 38400"
40 PRINT "SENDING PING..."
50 LET N=USR 16514
60 PRINT "GOT ";N;" BYTES:"
70 FOR I=0 TO N-1
80 PRINT PEEK (16640+I);" ";
90 NEXT I
100 PRINT
110 FOR I=0 TO N-1
120 LET B=PEEK (16640+I)
125 IF B=10 THEN GOTO 180
130 LET C=15
140 IF B>64 AND B<91 THEN LET C=B-27
150 IF B>47 AND B<58 THEN LET C=B-20
160 IF B=32 THEN LET C=0
170 PRINT CHR$ C;
180 NEXT I
190 PRINT
200 ZXPAND "CLO SER"
210 STOP
300 PRINT "LISTENING..."
310 LET N=USR 16529
320 GOTO 60
400 PRINT "PUT SER PING (BASIC)"
410 ZXPAND "OPE SER 38400"
420 ZXPAND "PUT SER PING"
430 GOTO 300
