100 SLOW
102 LET C=USR 16517
104 LET C$="NO SOUND CHIP?"
105 IF C=1 THEN LET C$="AY-3-8910"
106 IF C=2 THEN LET C$="YM2149"
107 IF C=3 THEN LET C$="AN UNKNOWN CHIP"
