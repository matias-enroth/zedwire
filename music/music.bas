190 LET K$=K$+CHR$ C
200 NEXT I
210 IF K$<>"" THEN GOTO 230
212 LET B=1
220 GOTO 500
230 CLS
240 PRINT "PLAYING ";K$;" ON ";C$
250 PRINT AT 3,0;"ANY KEY TO STOP  "
260 ZXPAND "OPE SER 38400"
